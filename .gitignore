# --- Game assets: NEVER commit retail-derived files ---
# Produced by scripts/prepare-gameres.ts from a legally-owned RA2 install.
gameres-export/
ios/Resources/GameRes/
ios/Resources/WebDist/
redalert2/public/local-pack/
# Retail English string tables, extracted from your language(md).mix at import time.
redalert2/public/general.csf
redalert2/public/generalmd.csf
# Chinese original, kept locally as a reference backup only.
redalert2/public/general.zh-CN.csf
# Upstream shipped this CDN-delivery bundle of retail INI data. Nothing in the
# local/iOS boot path reads it (GameRes only loads it on the CDN branch), so it
# is not distributed here. Verified by deleting it and playing a full match.
redalert2/public/ini.mix

